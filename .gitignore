# Ignore secrets
.env

# Ignore compiled binary files
target/

# Ignore log files
*.log
logs/
log/

# Ignore IDE settings
.vscode/
*.vim

# Ignore the Google OAuth2 secret and token cache
credentials.json
tokencache.json

# Ignore the asset generators' data (downloaded: see each script's docstring), not the
# scripts. `tools/*` and not `tools/`: git doesn't look for exceptions in an ignored folder.
tools/*
!tools/*.py
